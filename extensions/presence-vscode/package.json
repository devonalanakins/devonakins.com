{
  "name": "devonakins-presence",
  "displayName": "DevonAkins Presence",
  "version": "0.4.2",
  "publisher": "devonalanakins",
  "description": "Privacy-first editor presence and official Codex IDE/ChatGPT-plan launcher.",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "devonPresence.pair",
        "title": "Devon Presence: Pair Editor"
      },
      {
        "command": "devonPresence.project",
        "title": "Devon Presence: Configure Project Detection"
      },
      {
        "command": "devonPresence.resume",
        "title": "Devon Presence: Resume Sharing"
      },
      {
        "command": "devonPresence.pause",
        "title": "Devon Presence: Pause Sharing"
      },
      {
        "command": "devonPresence.disconnect",
        "title": "Devon Presence: Forget Pairing"
      },
      {
        "command": "devonPresence.codexIde",
        "title": "Devon Presence: Open Official Codex IDE"
      },
      {
        "command": "devonPresence.codexProfile",
        "title": "Devon Presence: Read Local ChatGPT Profile Tokens"
      },
      {
        "command": "devonPresence.codexAccount",
        "title": "Devon Presence: Check Codex ChatGPT Sign-in"
      },
      {
        "command": "devonPresence.codexStart",
        "title": "Devon Presence: Start Codex CLI with ChatGPT"
      },
      {
        "command": "devonPresence.codexLogin",
        "title": "Devon Presence: Open Codex ChatGPT Sign-in"
      },
      {
        "command": "devonPresence.codexUsage",
        "title": "Devon Presence: Review ChatGPT Usage"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devonalanakins/devonakins.com.git",
    "directory": "extensions/presence-vscode"
  }
}
